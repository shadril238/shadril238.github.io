---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>{{ site.title | xml_escape }} · Blogs</title>
    <subtitle>{{ site.description | xml_escape }}</subtitle>
    <link href="{{ '/feed.xml' | absolute_url }}" rel="self"/>
    <link href="{{ '/blogs.html' | absolute_url }}"/>
    <id>{{ '/blogs.html' | absolute_url }}</id>
    <updated>{% if site.posts.size > 0 %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
    <author><name>{{ site.author.name | xml_escape }}</name></author>
    {%- for post in site.posts limit: 20 %}
    <entry>
        <title>{{ post.title | xml_escape }}</title>
        <link href="{{ post.url | absolute_url }}"/>
        <id>{{ post.url | absolute_url }}</id>
        <published>{{ post.date | date_to_xmlschema }}</published>
        <updated>{{ post.updated | default: post.date | date_to_xmlschema }}</updated>
        <summary>{{ post.description | default: post.excerpt | strip_html | strip_newlines | xml_escape }}</summary>
        {%- if post.category %}
        <category term="{{ post.category | xml_escape }}"/>
        {%- endif %}
    </entry>
    {%- endfor %}
</feed>
